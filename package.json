{
  "name": "case-finder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "법제처 근거 기반 판례 검색기",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "start": "node src/server.js",
    "check": "node scripts/check.mjs",
    "test": "node --test test/*.test.js",
    "verify": "npm run check && npm test",
    "verify:managed": "node src/verifyManagedRuntime.js --skip-query"
  },
  "dependencies": {
    "@google/genai": "2.13.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@openai/codex": "0.147.0",
    "dotenv": "17.4.2",
    "korean-law-mcp": "4.12.1"
  },
  "overrides": {
    "onnxruntime-node": "^1.27.0",
    "sharp": "^0.35.3"
  }
}
