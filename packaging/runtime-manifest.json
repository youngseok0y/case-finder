{
  "version": "m10r-codex-sdk-v1",
  "installer_entrypoint": "CaseFinderSetup.exe",
  "install_root": "%LOCALAPPDATA%\\Fable\\CaseFinder",
  "layout": {
    "app": "app",
    "node": "runtime/node/node.exe",
    "node_modules": "app/node_modules",
    "logs": "logs"
  },
  "runtime": {
    "node": {
      "version": "24.14.0",
      "path": "runtime/node/node.exe",
      "range": ">=24.14.0 <25"
    },
    "codex_sdk": {
      "release": "0.147.0",
      "package": "@openai/codex-sdk",
      "codex_package": "@openai/codex",
      "platform_package": "@openai/codex-win32-x64",
      "target": "x86_64-pc-windows-msvc",
      "runtime_check": "src/lunaSdkRuntime.js inspectPackagedCodexRuntime"
    },
    "server": "app/src/server.js",
    "bind": "127.0.0.1",
    "adapters": ["gemini_d", "luna_native"]
  },
  "include": [
    "app/src/",
    "app/public/",
    "app/node_modules/",
    "app/prompts/plan.txt",
    "app/prompts/select.txt",
    "app/config.js",
    "app/package.json",
    "app/package-lock.json",
    "runtime/node/node.exe",
    ".env.example",
    "start.bat"
  ],
  "exclude": [
    ".git/",
    ".github/",
    "docs/",
    "test/",
    "test/private/",
    "logs/",
    "state/",
    ".env",
    "coverage/",
    "dist/",
    "release/",
    "*.exe",
    "*.zip"
  ],
  "runtime_dependencies": [
    "@google/genai",
    "@modelcontextprotocol/sdk",
    "@openai/codex-sdk",
    "dotenv",
    "korean-law-mcp"
  ],
  "notes": [
    "The installer provisions the private Node runtime and the pinned Codex SDK plus platform package under app/node_modules/.",
    "Final execution uses runtime/node/node.exe and never runs npm ci; dependencies are installed during packaging.",
    "luna_native uses the SDK packaged runtime and preserves the user's existing Codex authentication source without copying auth files.",
    "The normal product path does not use CODEX_CLI_PATH, system PATH, WindowsApps discovery, or manual Codex binary placement."
  ]
}
